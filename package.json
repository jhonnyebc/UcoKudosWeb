{
  "name": "ucokudos-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cliente web mobile first de UCO Kudos (ADR-0015)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ver": "vitest",
    "lint": "eslint . --max-warnings 0",
    "formato": "prettier --check .",
    "formato:arreglar": "prettier --write .",
    "tipos:api": "openapi-typescript ../UcoKudos/docs/openapi.json -o src/api/contrato.d.ts",
    "peso": "node scripts/presupuesto-de-peso.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.9.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "6.4.6",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0",
    "workbox-precaching": "^7.3.0"
  }
}
